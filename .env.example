# Complete reference of every environment variable the bot reads.
# Copy to .env and fill in. Only DISCORD_TOKEN and CLIENT_ID are required; every other
# value is optional and the related command degrades gracefully without it.
# tests/utils/env-contract.test.js fails if the code reads a variable missing here.

# ── Discord (required) ──────────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
# Guild for `bun run deploy` (instant guild commands); deploy/clear scripts only
GUILD_ID=

# ── Access control ──────────────────────────────────────────────────────────
# Comma-separated guild IDs the bot may operate in (empty = all; it leaves others)
ALLOWED_GUILD_IDS=
# Comma-separated role IDs that may use restricted commands without the permission
OSINT_ALLOWED_ROLES=
# Per-user daily command limit
RATE_LIMIT_DAILY=200
# Channel for /bob-monitor alerts
MONITOR_CHANNEL_ID=

# ── Docker image (read by docker-compose.yml, not by the bot) ───────────────
# slim (default, no CLI tools) or full (Sherlock, Maigret, GHunt, Nuclei, ExifTool,
# jwt_tool, Linkook, xeuledoc). Rebuild and re-deploy commands after changing.
# BOT_TARGET=slim

# ── Operations ──────────────────────────────────────────────────────────────
# pino level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Health state file read by the Docker healthcheck
# HEALTH_FILE=./temp/.health/health.json
# Prometheus metrics (off by default; binds to localhost, put auth in front to expose)
# METRICS_ENABLED=false
# METRICS_PORT=9090
# METRICS_HOST=127.0.0.1
# Command exports: owner-only and ephemeral by default (tmpfs in Docker, private /tmp
# under systemd). Point at a persistent path to keep them; pruned after N days.
# REPORTS_DIR=./reports
# REPORTS_RETENTION_DAYS=30
# Webhook for /bob-redirect-check security alerts
SECURITY_WEBHOOK_URL=

# ── API keys ────────────────────────────────────────────────────────────────
# 1min.ai: /bob-chat and /bob-upload
AI_API_KEY=
# DNSDumpster: /bob-dns
DNSDUMPSTER_TOKEN=
# Whoxy: /bob-whoxy
WHOXY_API_KEY=
# Host.io: /bob-hostio
HOSTIO_API_KEY=
# Pappers: /bob-pappers
PAPPERS_API_KEY=
# Etherscan API V2: one key for every EVM chain in /bob-blockchain
# (free plan: Ethereum, Polygon and testnets; BNB Chain needs a paid plan)
ETHERSCAN_API_KEY=
# AviationStack: /bob-flight
AVIATIONSTACK_API_KEY=
# AirportDB: /bob-airport
AIRPORTDB_API_KEY=
# Nike: /bob-nike (expires after ~1 hour; Manage Server can replace it with token:)
NIKE_TOKEN=
# AWS Rekognition: /bob-rekognition
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── External tools (only outside the full Docker image, which ships them) ───
# EXIFTOOL_PATH=exiftool
# SHERLOCK_PATH=sherlock
# MAIGRET_PATH=maigret
# NUCLEI_PATH=nuclei
# NUCLEI_TEMPLATE_PATH=/opt/nuclei-templates/http/osint/user-enumeration
# JWT_TOOL_PATH=/opt/tools/jwt_tool
# Wordlist for /bob-jwt crack mode:dict (default: jwt_tool's jwt-common.txt; mount a
# bigger one, e.g. rockyou, and point here)
# JWT_WORDLIST=/opt/tools/jwt_tool/jwt-common.txt
# GHunt credentials, written by /bob-ghunt type:login. The ghunt CLI reads
# $HOME/.malfrats, so keep the default (Docker: bot-home volume; systemd:
# /var/lib/discord-osint-assistant)
# GHUNT_CREDS_PATH=~/.malfrats/ghunt/creds.m
