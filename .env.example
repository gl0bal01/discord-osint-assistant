# Docker image: slim (default, no CLI tools) or full (adds Sherlock, Maigret,
# GHunt, Nuclei, ExifTool, ... ~1GB). Rebuild after changing: docker compose up -d --build
# BOT_TARGET=slim

LOG_LEVEL=info
# HEALTH_FILE=./temp/.health/health.json
# METRICS_ENABLED=false
# METRICS_PORT=9090
# METRICS_HOST=127.0.0.1

# Discord (required)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Channel for /bob-monitor alerts
MONITOR_CHANNEL_ID=

# Access control (comma-separated, leave empty to allow all)
ALLOWED_GUILD_IDS=
OSINT_ALLOWED_ROLES=

# API keys (all optional — commands degrade gracefully without them)
DNSDUMPSTER_TOKEN=
WHOXY_API_KEY=
HOSTIO_API_KEY=
AVIATIONSTACK_API_KEY=
AIRPORTDB_API_KEY=
PAPPERS_API_KEY=
NIKE_TOKEN=
AI_API_KEY=
VIRUSTOTAL_API_KEY=

# Blockchain explorers: one Etherscan API V2 key covers every EVM chain
# (free plan: Ethereum, Polygon and testnets; BNB Chain needs a paid plan)
ETHERSCAN_API_KEY=

# AWS Rekognition
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Security webhook for redirect-chain alerts
SECURITY_WEBHOOK_URL=

# External tool paths (only set if not in PATH; the full Docker image needs none)
# EXIFTOOL_PATH=exiftool
# SHERLOCK_PATH=sherlock
# MAIGRET_PATH=maigret
# NUCLEI_PATH=nuclei
# NUCLEI_TEMPLATE_PATH=/opt/nuclei-templates/http/osint/user-enumeration
# JWT_TOOL_PATH=/opt/tools/jwt_tool

# Optional: per-user daily command limit (default 200)
RATE_LIMIT_DAILY=200

# Reports archive (durable copies of command exports)
# REPORTS_DIR=./reports              # where exports are archived
# REPORTS_RETENTION_DAYS=30          # auto-prune reports older than N days
