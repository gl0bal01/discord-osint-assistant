[Unit]
Description=Discord OSINT Assistant Bot
Documentation=https://github.com/gl0bal01/discord-osint-assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/discord-osint-assistant
EnvironmentFile=/etc/discord-osint-assistant.env
ExecStart=/usr/bin/bun run start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-osint

# Resource limits (mirrors docker-compose)
MemoryMax=512M
TasksMax=50
LimitNOFILE=1024

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/discord-osint-assistant/temp
# Reports are ephemeral: kept in the private /tmp, wiped when the service stops.
# Set REPORTS_DIR in the env file to keep them on disk (add it to ReadWritePaths).
Environment=REPORTS_DIR=/tmp/reports
# No WatchdogSec: the bot doesn't send sd_notify keep-alives, so systemd would
# kill it every interval. Crashes are covered by Restart=always; gateway health
# is in temp/.health/health.json (bun run scripts/healthcheck.js).

[Install]
WantedBy=multi-user.target
