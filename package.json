{
  "name": "discord-osint-assistant",
  "version": "3.0.0",
  "description": "A powerful Discord bot for Open Source Intelligence (OSINT) gathering and analysis",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "deploy": "node deploy-commands.js",
    "deploy:global": "node deploy-commands.js --global",
    "clear": "node clear-commands.js --force",
    "clear:global": "node clear-commands.js --global --force",
    "clear:all": "node clear-commands.js --all --force",
    "clear:list": "node clear-commands.js --list",
    "redeploy": "bun run clear && bun run deploy",
    "redeploy:global": "bun run clear:global && bun run deploy:global",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.js",
    "docs:commands": "node scripts/gen-commands-doc.js",
    "lint": "eslint .",
    "knip": "knip",
    "ci": "bash scripts/ci-local.sh",
    "ci:fast": "bash scripts/ci-local.sh --fast",
    "clean": "rm -rf temp/*"
  },
  "keywords": [
    "discord",
    "bot",
    "osint",
    "intelligence",
    "reconnaissance",
    "investigation",
    "security",
    "analysis",
    "blockchain",
    "social-engineering",
    "cybersecurity"
  ],
  "author": "gl0bal01",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gl0bal01/discord-osint-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/gl0bal01/discord-osint-assistant/issues"
  },
  "homepage": "https://github.com/gl0bal01/discord-osint-assistant#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1163.0",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "form-data": "^4.0.6",
    "murmurhash": "^2.0.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "knip": "^6.44.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "overrides": {
    "lodash": ">=4.17.24",
    "brace-expansion": ">=5.0.5",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.10",
    "vite": ">=8.0.5",
    "minimatch": "^11.0.1"
  }
}
